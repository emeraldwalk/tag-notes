{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Tracker (plan 07): notes, food, glucose and medicine for one person, at tracker.ingles.place, signed in through
  // the family IdP. Secrets, set with `npx wrangler secret put <NAME>` from worker/: IDP_CLIENT_ID,
  // IDP_CLIENT_SECRET, COOKIE_SECRET; plan 14's LLU_EMAIL, LLU_PASSWORD, HA_INGEST_TOKEN. See README "Deploying".
  "name": "tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "tracker.ingles.place", "custom_domain": true }],
  // Plan 8: the PWA, built by package.json's "build" / "deploy" (base "/"). The Worker runs first on every request,
  // so pages sit behind sign-in; it hands them to ASSETS, which falls back to index.html for app routes.
  "assets": {
    "directory": "../pwa/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tracker",
      "database_id": "a45286ac-aa49-43bd-8aba-ed34904259b3",
      "migrations_dir": "migrations"
    }
  ],
  // Plan 14: poll LibreLinkUp every 5 minutes (one of the account's 5 free-plan cron triggers).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "IDP_ISSUER": "https://auth.emeraldwalk.com",
    // The owner's time zone, for local dates. Not `TZ`, which is the container's.
    "TZ_NAME": "America/Chicago",
    // Overridden at deploy with the commit Workers Builds is building (package.json "deploy").
    "BUILD_COMMIT": "dev",
    // Plan 14: the IdP user id (shown on the home page) that polled and pushed glucose readings belong to.
    "OWNER_USER_ID": "j8tSwNOzQWO3auoNg1IHMUJAnu3sGgYY",
    // LibreLinkUp's region ("us", "eu", ...; a wrong one is redirected) and the app version its API expects.
    "LLU_REGION": "us",
    "LLU_VERSION": "4.16.0"
  }
}
