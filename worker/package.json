{
  "name": "tracker-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "deploy": "wrangler d1 migrations apply tracker --remote && wrangler deploy --var BUILD_COMMIT:${WORKERS_CI_COMMIT_SHA:-dev}"
  },
  "dependencies": {
    "@emeraldwalk/idp-client": "0.1.6",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "oxlint": "^1.90.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.156.0"
  }
}
